{
	"name": "PowerGrid",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"Shared": {
				"$path": "src/shared"
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"Server": {
				"$path": "src/server"
			}
		},
		"ServerStorage": {
			"$className": "ServerStorage",
			"Models": {
				"$path": "assets/models"
			}
		},
		"Workspace": {
			"$className": "Workspace",
			"$properties": {
				"StreamingEnabled": true,
				"StreamingMinRadius": 192,
				"StreamingTargetRadius": 640,
				"StreamOutBehavior": "Opportunistic"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"Client": {
					"$path": "src/client"
				}
			}
		}
	},
	"globIgnorePaths": [
		"src/server/**/*.test.luau"
	]
}
