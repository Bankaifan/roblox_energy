-- The language for a player's locale: German for "de", "de-de" and the like; English for everything else or no locale.
function Locale.resolve(localeId: string?): string
	if localeId ~= nil and string.sub(string.lower(localeId), 1, 2) == "de" then
		return "de"
	end
	return Locale.DEFAULT
end

-- The text for `key` in `lang`, with each {name} replaced by args.name. A key missing in that language falls back to
-- English, and a key missing everywhere is returned as it is. A placeholder without an argument stays visible.
function Locale.t(key: string, lang: string, args: { [string]: any }?): string
	local dictionary = Locale.tables[lang] or Locale.tables[Locale.DEFAULT]
	local text = dictionary[key] or Locale.tables[Locale.DEFAULT][key] or key
	-- With a table as the replacement, gsub keeps a placeholder whose argument is missing.
	return (string.gsub(text, "{(%w+)}", args or {}))
end

return Locale
