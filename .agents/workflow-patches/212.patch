@@ -0,0 +1,84 @@
+name: cleaner
+# Weekly: removes code, workflows, rules and texts nobody needs (.agents/roles/cleaner.md), each removal with proof,
+# one small commit per removal, one PR. The PR takes the normal path (CI, reviewer, train). CLEANER=off disables it.
+on:
+  schedule:
+    - cron: "41 4 * * 3"
+  workflow_dispatch:
+permissions:
+  contents: read
+concurrency:
+  group: cleaner
+  cancel-in-progress: false
+jobs:
+  clean:
+    if: (vars.CLEANER || 'on') != 'off'
+    runs-on: ${{ vars.RUNNER || 'ubuntu-latest' }}
+    timeout-minutes: 40
+    steps:
+      - name: Fail if a required repo variable is unset
+        env:
+          AUTHOR_CLIENT_ID: ${{ vars.AUTHOR_CLIENT_ID }}
+          AUTHOR_BOT: ${{ vars.AUTHOR_BOT }}
+        run: |
+          for n in AUTHOR_CLIENT_ID AUTHOR_BOT; do
+            [ -n "${!n}" ] || { echo "::error::Repo variable $n is not set (Settings > Secrets and variables > Actions > Variables)."; exit 1; }
+          done
+      - id: app
+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0
+        with:
+          client-id: ${{ vars.AUTHOR_CLIENT_ID }}
+          private-key: ${{ secrets.AUTHOR_APP_KEY }}
+          permission-contents: write
+          permission-pull-requests: write
+          permission-issues: write
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1  # zizmor: ignore[artipacked] this job pushes with the app token persisted by checkout
+        with:
+          token: ${{ steps.app.outputs.token }}
+          fetch-depth: 0
+      - name: Git identity
+        run: |
+          git config user.name "Daniel"
+          git config user.email "476059+Bankaifan@users.noreply.github.com"
+      # One cleaner PR at a time (no model run while one is open). The model is denied `git checkout -b`: the script creates the branch.
+      - name: Cleaner branch
+        id: branch
+        env:
+          GH_TOKEN: ${{ steps.app.outputs.token }}
+        run: |
+          open=$(gh pr list --state open --json headRefName --jq '[.[] | select(.headRefName | startswith("agent/cleaner-"))] | length')
+          if [ "$open" != "0" ]; then echo "a cleaner PR is open: nothing to do"; exit 0; fi
+          git checkout -b "agent/cleaner-$(date +%F)"
+          echo "go=true" >> "$GITHUB_OUTPUT"
+      # `make check` needs ruff, pytest, actionlint and zizmor; the allow list only has the exact command `make check`.
+      - if: steps.branch.outputs.go == 'true'
+        uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0 # v7.1.0
+        with:
+          python-version: ${{ vars.PYTHON_VERSION || '3.x' }}
+      - name: Install pinned CI tools (ruff, pytest, actionlint, zizmor)
